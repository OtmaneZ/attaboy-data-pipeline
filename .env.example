# Copy to /opt/clients/attaboy/.env (chmod 600, owner attaboy). Never commit secrets.

# Runtime
ATTABOY_HOME=/opt/clients/attaboy

# Snowflake — utilisateur de service, authentification par paire de clés
# Identifiant de compte au format <org>-<account> (Snowsight → Admin → Accounts)
ATTABOY_SF_ACCOUNT=
ATTABOY_SF_USER=ATTABOY_PIPELINE_SVC
ATTABOY_SF_ROLE=ATTABOY_PIPELINE
ATTABOY_SF_WAREHOUSE=ATTABOY_WH
ATTABOY_SF_DATABASE=ATTABOY_DW
# Clé privée PKCS#8 (chmod 600, owner attaboy), hors du repo
ATTABOY_SF_PRIVATE_KEY_PATH=/opt/clients/attaboy/keys/snowflake_rsa_key.p8
ATTABOY_SF_PRIVATE_KEY_PASSPHRASE=

# Clover (sandbox first)
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_BASE_URL=https://apisandbox.dev.clover.com

# Ingest Clover — lookback si aucun succès antérieur dans META.PIPELINE_RUNS
ATTABOY_CLOVER_LOOKBACK_DAYS=7
